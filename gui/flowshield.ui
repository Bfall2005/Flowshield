        <property name="styleSheet">
         <string notr="true">/* Bottom navigation frame */
QFrame#frame_Navigation {
    background-color: #FFFFFF;
    border: 1px solid #D5E3E8;
    border-radius: 8px;
}

/* Back to Setup button */
QPushButton#btnBack {
    background-color: #FFFFFF;
    color: #087F8C;
    border: 1px solid #087F8C;
    border-radius: 7px;
    font-size: 13px;
    font-weight: bold;
    padding: 10px;
}

/* Back button hover */
QPushButton#btnBack:hover {
    background-color: #DDEEF0;
}

/* Run Again button */
QPushButton#btnRun {
    background-color: #087F8C;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    font-size: 13px;
    font-weight: bold;
    padding: 10px;
}

/* Run Again hover */
QPushButton#btnRun:hover {
    background-color: #066773;
}</string>
