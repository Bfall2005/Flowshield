        <property name="styleSheet">
         <string notr="true">/* Parent frame containing all three boxes */
QFrame#frameSummary {
    background-color: transparent;
    border: none;
}

/* Individual white summary boxes */
QFrame#frameInitialVolume,
QFrame#frameFinalVolume,
QFrame#frameAlertStatus {
    background-color: #FFFFFF;
    border: 1px solid #D5E3E8;
    border-radius: 10px;
}

/* Heading labels */
QLabel#lblInitialTitle,
QLabel#lblFinalTitle,
QLabel#lblAlertTitle {
    color: #526778;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
    border: none;
}

/* Value labels */
QLabel#lblInitialVolume,
QLabel#lblFinalVolume,
QLabel#lblAlertStatus {
    color: #087F8C;
    font-family: &quot;Segoe UI&quot;;
    font-size: 21px;
    font-weight: bold;
    background-color: transparent;
    border: none;
}</string>
