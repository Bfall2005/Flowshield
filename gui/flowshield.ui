      <property name="styleSheet">
       <string notr="true">/* FlowShield background */
QMainWindow,
QWidget#centralwidget,
QWidget#pageConfiguration,
QWidget#pageResults {
    background-color: #EAF2F5;
}

/* Text and headings */
QLabel {
    color: #17324D;
}

/* Input fields */
QSpinBox, QComboBox {
    background-color: #FFFFFF;
    color: #263746;
    border: 1px solid #B8CDD5;
    border-radius: 6px;
    padding: 6px;
    min-height: 24px;
}

/* Highlight selected inputs */
QSpinBox:focus, QComboBox:focus {
    border: 2px solid #087F8C;
}

/* Run Simulation button */
QPushButton#btnRunSimulation {
    background-color: #087F8C;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    padding: 12px;
}

/* Hover effect */
QPushButton#btnRunSimulation:hover {
    background-color: #066773;
}

/* Button pressed */
QPushButton#btnRunSimulation:pressed {
    background-color: #054F59;
}</string>
